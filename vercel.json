{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "Frontend/dist",
  "regions": ["sin1"],
  "redirects": [
    { "source": "/shortenurl", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/s/:code", "destination": "/api/index" },
    { "source": "/qr-maker", "destination": "/qr-maker.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/my-links/:path*", "destination": "/index.html" },
    { "source": "/link-unavailable/:path*", "destination": "/index.html" },
    { "source": "/link-access/:path*", "destination": "/index.html" },
    { "source": "/:code", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/:section(dashboard|login|register|my-links|link-access|link-unavailable|api|s|health)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
