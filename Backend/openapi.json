{
  "openapi": "3.0.3",
  "info": {
    "title": "ShortURL API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3211"
    }
  ],
  "paths": {
    "/api/short-urls": {
      "get": {
        "operationId": "listShortUrls",
        "summary": "List recent short URLs",
        "responses": {
          "200": {
            "description": "Recent short URLs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortUrlListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createShortUrl",
        "summary": "Create a short URL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShortUrlRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Short URL created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload"
          },
          "409": {
            "description": "Custom alias is already in use"
          }
        }
      }
    },
    "/api/short-urls/{code}": {
      "get": {
        "operationId": "getShortUrl",
        "summary": "Get short URL detail",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Short URL detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "404": {
            "description": "Short URL not found"
          }
        }
      }
    },
    "/api/short-urls/{code}/access": {
      "get": {
        "operationId": "getLinkAccess",
        "summary": "Check link availability without recording a visit",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Public availability without destination or account metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LinkAccessResponse" }
              }
            }
          },
          "404": { "description": "Short URL not found" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "409": {
            "description": "Email already registered"
          },
          "429": {
            "description": "Too many attempts"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "409": {
            "description": "Email already registered"
          },
          "429": {
            "description": "Too many attempts"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logoutUser",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/my-links": {
      "get": {
        "operationId": "listMyLinks",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Your most recent 100 links",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortUrlListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Login required"
          }
        }
      }
    },
    "/api/library/organization": {
      "get": {
        "operationId": "getOrganization",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Name or color already exists"
          }
        }
      }
    },
    "/api/library/tags": {
      "post": {
        "operationId": "createTag",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTag"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Name or color already exists"
          }
        }
      }
    },
    "/api/library/folders": {
      "post": {
        "operationId": "createFolder",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFolder"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Name or color already exists"
          }
        }
      }
    },
    "/api/library/qr": {
      "post": {
        "operationId": "saveQr",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQr"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Name or color already exists"
          }
        }
      }
    },
    "/api/library/links/{id}": {
      "patch": {
        "operationId": "updateLink",
        "summary": "Edit an owned link without changing its alias or statistics",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateLink" } } }
        },
        "responses": {
          "200": { "description": "Updated link", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ShortUrlResponse" } } } },
          "400": { "description": "Invalid content, schedule or organization" },
          "401": { "description": "Login required" },
          "404": { "description": "Item not found" }
        }
      },
      "delete": {
        "operationId": "deleteLink",
        "summary": "Permanently delete an owned link and its visit logs",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "204": { "description": "Deleted" },
          "400": { "description": "Invalid ID" },
          "401": { "description": "Login required" },
          "404": { "description": "Item not found" }
        }
      }
    },
    "/api/library/links/{id}/pin": {
      "patch": {
        "operationId": "pinLink",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PinResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Name or color already exists"
          }
        }
      }
    },
    "/api/library/links/{id}/statistics": {
      "get": {
        "operationId": "getStatistics",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatisticsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Name or color already exists"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateShortUrlRequest": {
        "type": "object",
        "required": [
          "originalUrl"
        ],
        "properties": {
          "originalUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/very/long/path"
          },
          "customCode": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-zA-Z0-9_-]{3,32}$",
            "example": "my-link"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "example": "Example link"
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "folderId": {
            "type": "string",
            "nullable": true
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ShortUrl": {
        "type": "object",
        "required": [
          "id",
          "code",
          "originalUrl",
          "shortUrl",
          "clickCount",
          "createdAt",
          "updatedAt",
          "kind",
          "folderId",
          "folderName",
          "startsAt",
          "expiresAt",
          "isPinned",
          "isEnabled",
          "tags",
          "qrOptions",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "originalUrl": {
            "type": "string",
            "format": "uri"
          },
          "shortUrl": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "clickCount": {
            "type": "integer"
          },
          "lastClickedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "url",
              "qr"
            ]
          },
          "folderId": {
            "type": "string",
            "nullable": true
          },
          "folderName": {
            "type": "string",
            "nullable": true
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isPinned": {
            "type": "boolean"
          },
          "isEnabled": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "qrOptions": {
            "nullable": true,
            "allOf": [
              { "$ref": "#/components/schemas/QrOptions" }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "scheduled",
              "expired",
              "disabled"
            ]
          }
        }
      },
      "ShortUrlResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ShortUrl"
          }
        }
      },
      "LinkAccessResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["status", "startsAt", "shortUrl"],
            "properties": {
              "status": { "type": "string", "enum": ["active", "scheduled", "expired", "disabled"] },
              "startsAt": { "type": "string", "format": "date-time", "nullable": true },
              "shortUrl": { "type": "string", "format": "uri" }
            }
          }
        }
      },
      "ShortUrlListResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShortUrl"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "At most 72 UTF-8 bytes"
          }
        }
      },
      "Tag": {
        "type": "object",
        "required": [
          "id",
          "name",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      },
      "Folder": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "QrOptions": {
        "type": "object",
        "required": [
          "style",
          "color",
          "size"
        ],
        "properties": {
          "style": {
            "type": "string",
            "enum": [
              "square",
              "rounded",
              "dots",
              "classy"
            ]
          },
          "color": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "enum": [
              300,
              600,
              1000
            ]
          }
        }
      },
      "Organization": {
        "type": "object",
        "required": [
          "tags",
          "folders"
        ],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "folders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Folder"
            }
          }
        }
      },
      "CreateTag": {
        "type": "object",
        "required": [
          "name",
          "color"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      },
      "CreateFolder": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateQr": {
        "type": "object",
        "required": [
          "originalUrl",
          "qrOptions"
        ],
        "properties": {
          "originalUrl": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "qrOptions": {
            "$ref": "#/components/schemas/QrOptions"
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "folderId": {
            "type": "string",
            "nullable": true
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TagResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Tag"
          }
        }
      },
      "FolderResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Folder"
          }
        }
      },
      "UpdateLink": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "originalUrl": { "type": "string", "minLength": 1, "description": "HTTP/HTTPS URL for URL items; up to 1000 characters for QR content" },
          "title": { "type": "string", "maxLength": 160 },
          "isEnabled": { "type": "boolean", "description": "Temporarily enable or disable access without changing the schedule" },
          "tagIds": { "type": "array", "maxItems": 20, "items": { "type": "string", "format": "uuid" } },
          "folderId": { "type": "string", "format": "uuid", "nullable": true },
          "startsAt": { "type": "string", "format": "date-time", "nullable": true },
          "expiresAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "PinRequest": {
        "type": "object",
        "required": [
          "isPinned"
        ],
        "properties": {
          "isPinned": {
            "type": "boolean"
          }
        }
      },
      "PinResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PinRequest"
          }
        }
      },
      "StatisticsResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "item",
              "daily"
            ],
            "properties": {
              "cacheExpiresAt": {
                "type": "string",
                "format": "date-time",
                "description": "Expiry of the cached daily statistics; at most five minutes after collection."
              },
              "item": {
                "$ref": "#/components/schemas/ShortUrl"
              },
              "daily": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "date",
                    "clicks"
                  ],
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "clicks": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "qlean_session"
      }
    }
  }
}
