# Optional Docker Compose overrides. Defaults work without a .env file.
FRONTEND_PORT=3210
BACKEND_PORT=3211
POSTGRES_PORT=5432
REDIS_PORT=6379

# Public browser-facing URLs default to localhost with the ports above.
# SHORT_URL_BASE=https://mydomain.com
# APP_BASE_URL is supported as a fallback when SHORT_URL_BASE is unset.
# WEB_ORIGIN=https://your-domain.example

# Optional stable random secret (at least 32 characters) to retain login sessions
# across Backend restarts. Without it, a new secret is generated on each start.
JWT_SECRET=
